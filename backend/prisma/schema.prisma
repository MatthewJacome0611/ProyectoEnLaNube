generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id        Int     @id @default(autoincrement())
  nombre    String  @db.VarChar(255)
  categoria String  @db.VarChar(120)
  pvp       Decimal @db.Decimal(10, 2)

  @@map("productos")
}